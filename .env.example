# Clerk Authentication Feature Flag
# Authentication is disabled by default for desktop and local usage.
# Set to 'true' to enable the Clerk authentication gate.
VITE_ENABLE_AUTH=false

# Clerk Publishable Key (required only when VITE_ENABLE_AUTH=true)
# Retrieve your Publishable Key from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_key
